syntax on
set nu
set encoding=utf-8
filetype on
filetype plugin on
filetype indent on
set nobackup

set autoindent
set tabstop=2
set softtabstop=2
set scrolloff=10
set expandtab

set incsearch
set hlsearch
set smartcase
set list

set wildmenu
set wildmode=list:longest
set showcmd
set showmatch
set history=200
set confirm
set showmode

colorscheme torte
set cursorline
set clipboard=unnamed

set noerrorbells

set laststatus=2

let g:indentLine_enabled=1
let g:indentLine_leadingSpaceEnabled=1
let g:indentLine_leadingSpaceChar='.'
let g:indentLine_indentLevel=1
let g:indentLine_char=''
