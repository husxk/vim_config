syntax on
set nu
set encoding=utf-8

set smartindent
set expandtab
set tabstop=2
set softtabstop=2
set scrolloff=10

set incsearch
set hlsearch
set ignorecase
set smartcase
set list

set wildmenu
set showcmd
set showmatch
set history=200
set confirm

colorscheme wildcharm 
set cursorline
set clipboard=unnamed

set noerrorbells

let g:indentLine_enabled=1
let g:indentLine_leadingSpaceEnabled=1
let g:indentLine_leadingSpaceChar='.'
let g:indentLine_indentLevel=1
let g:indentLine_char=''
